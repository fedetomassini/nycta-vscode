  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#7D7D7D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation",
      "scope": [
        "comment.block.documentation",
        "punctuation.definition.comment.documentation"
      ],
      "settings": {
        "foreground": "#7D7D7D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.modifier",
        "storage.type",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#E896BD"
      }
    },
    {
      "name": "Operator keywords",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical",
        "keyword.operator.expression.typeof"
      ],
      "settings": {
        "foreground": "#E896BD"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.generic"
      ],
      "settings": {
        "foreground": "#999999"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#94D7A2"
      }
    },
    {
      "name": "String template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end"
      ],
      "settings": {
        "foreground": "#E896BD"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#E5CF98"
      }
    },
    {
      "name": "Numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": {
        "foreground": "#E896BD"
      }
    },
    {
      "name": "General constants",
      "scope": [
        "constant.other",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#91DCE7"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#9EB5EF"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "meta.function entity.name.function",
        "meta.method.declaration entity.name.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#9EB5EF"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#9B96E8"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#9B96E8"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "meta.function.parameter"
      ],
      "settings": {
        "foreground": "#B7B7B7"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "identifier"
      ],
      "settings": {
        "foreground": "#B7B7B7"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "meta.mapping.key"
      ],
      "settings": {
        "foreground": "#EFB9A0"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "support.variable",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#E896BD"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#E5CF98"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#E896BD"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#EFB9A0"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#E5CF98"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#EFB9A0"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color.css",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#94D7A2"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#E896BD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#B7B7B7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italics",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#B7B7B7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline"
      ],
      "settings": {
        "foreground": "#9EB5EF"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#94D7A2"
      }
    },
    {
      "name": "Diff added",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#94D7A2"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#E49894"
      }
    },
    {
